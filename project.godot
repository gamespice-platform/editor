; Engine configuration file.
config_version=5

[application]

config/name="gs-editor"
config/description="In-game build mode: place props, keep the result as a map document, and check every edit against permissions, bounds and budgets before it is accepted."
run/main_scene="res://examples/editor_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gs_editor/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
